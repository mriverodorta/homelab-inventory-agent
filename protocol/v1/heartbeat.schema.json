{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelabinventory.com/schemas/agent/v1/heartbeat.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolMajor", "sequence", "agentVersion", "collectedAt", "host", "capabilities", "metrics"],
  "properties": {
    "protocolMajor": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "agentVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "collectedAt": { "type": "string", "format": "date-time" },
    "host": { "$ref": "common.schema.json#/$defs/hostRef" },
    "hostname": { "type": "string", "maxLength": 255 },
    "droppedSamples": { "type": "integer", "minimum": 0 },
    "capabilities": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": { "$ref": "common.schema.json#/$defs/capability" }
    },
    "metrics": { "$ref": "metrics.schema.json" },
    "services": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "service.schema.json" }
    },
    "containers": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "container.schema.json" }
    },
    "storageHealth": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "storage-health.schema.json" }
    }
  }
}
