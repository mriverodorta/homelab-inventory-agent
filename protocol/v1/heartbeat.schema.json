{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelabinventory.com/schemas/agent/v1/heartbeat.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolMajor", "sequence", "agentVersion", "collectedAt", "host", "metrics"],
  "anyOf": [
    { "required": ["capabilities"] },
    { "required": ["capabilitiesHash"] }
  ],
  "properties": {
    "protocolMajor": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "agentVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "collectedAt": { "type": "string", "format": "date-time" },
    "host": { "$ref": "common.schema.json#/$defs/hostRef" },
    "hostname": { "type": "string", "maxLength": 255 },
    "droppedSamples": { "type": "integer", "minimum": 0 },
    "monitoringRevision": { "type": "integer", "minimum": 0 },
    "capabilities": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": { "$ref": "common.schema.json#/$defs/capability" }
    },
    "capabilitiesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metrics": { "$ref": "metrics.schema.json" },
    "services": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "service.schema.json" }
    },
    "containers": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "container.schema.json" }
    },
    "storageHealth": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "storage-health.schema.json" }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": { "$ref": "#/$defs/serviceState" },
        "containers": { "$ref": "#/$defs/containerState" },
        "filesystems": { "$ref": "#/$defs/objectState" },
        "gpus": { "$ref": "#/$defs/objectState" },
        "sensors": { "$ref": "#/$defs/objectState" },
        "system": { "$ref": "#/$defs/objectState" },
        "storageHealth": { "$ref": "#/$defs/storageHealthState" }
      }
    }
  },
  "$defs": {
    "stateBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "full", "changed", "removed"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "full": { "type": "boolean" },
        "changed": { "type": "array", "maxItems": 512 },
        "removed": { "type": "array", "maxItems": 512, "items": { "type": "string", "maxLength": 512 } }
      }
    },
    "serviceState": {
      "allOf": [
        { "$ref": "#/$defs/stateBase" },
        { "properties": { "changed": { "type": "array", "maxItems": 512, "items": { "$ref": "service.schema.json" } } } }
      ]
    },
    "containerState": {
      "allOf": [
        { "$ref": "#/$defs/stateBase" },
        { "properties": { "changed": { "type": "array", "maxItems": 256, "items": { "$ref": "container.schema.json" } } } }
      ]
    },
    "objectState": {
      "allOf": [
        { "$ref": "#/$defs/stateBase" },
        { "properties": { "changed": { "type": "array", "maxItems": 512, "items": { "type": "object" } } } }
      ]
    },
    "storageHealthState": {
      "allOf": [
        { "$ref": "#/$defs/stateBase" },
        { "properties": { "changed": { "type": "array", "maxItems": 64, "items": { "$ref": "storage-health.schema.json" } } } }
      ]
    }
  }
}
